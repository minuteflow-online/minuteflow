{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/idle-timeout",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/invoice-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recurring-tasks",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/screenshot-health",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/generate-recurring-invoices",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron/generate-paystubs",
      "schedule": "0 8 1,16 * *"
    },
    {
      "path": "/api/cron/team-digest?kind=today",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/team-digest?kind=tomorrow",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/team-digest?kind=weekly",
      "schedule": "0 21 * * 5"
    }
  ]
}
